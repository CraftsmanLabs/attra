{
  "emitter": "kcov",
  "image": "debian:trixie-20261027",
  "tools": {
    "kcov": "kcov 43+dfsg-1+b4",
    "gcc": "gcc (Debian 14.2.0-19) 14.2.0"
  },
  "steps": [
    {
      "cwd": "/work/shell",
      "command": "kcov --include-path=/work/shell out-shell ./classify.sh"
    },
    {
      "cwd": "/work/c",
      "command": "./build.sh gcc g++ -O0 -g"
    },
    {
      "cwd": "/work/c",
      "command": "kcov --include-path=/work/c out-c ./build/test"
    }
  ],
  "notes": [
    "compiled/: for compiled code kcov's per-line hits count breakpoint addresses on the line, not executions"
  ],
