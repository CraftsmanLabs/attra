{
  "emitter": "node",
  "image": "node:24.22.2-bookworm",
  "tools": {
    "node": "v24.22.2",
    "nyc": "18.0.0",
    "c8": "12.0.0"
  },
  "steps": [
    {
      "cwd": "/work/js",
      "command": "npm ci --silent"
    },
    {
      "cwd": "/work/js",
      "command": "bash -c ../gen-big.sh js > gen/big.js"
    },
    {
      "cwd": "/work/js",
      "command": "npx nyc --all --include src/** --include lib/** --include gen/** --reporter=json --reporter=lcovonly --reporter=cobertura --reporter=clover --reporter=json-summary node test/run.js"
    },
    {
      "cwd": "/work/js",
      "command": "npx c8 --all --include src/** --include lib/** --include gen/** --reporter=json --reporter=lcovonly --reporter=cobertura --reporter=clover node test/run.js"
    },
    {
      "cwd": "/work/js",
      "command": "env NODE_V8_COVERAGE=v8 node test/run.js"
    },
    {
      "cwd": "/work/js",
      "command": "node /corpus/emitters/node/filter-v8.js v8 v8.json"
    },
    {
      "cwd": "/work/js",
      "command": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=node-test.info test/run.test.js"
    }
  ],
  "notes": [
    "v8/coverage.json is NODE_V8_COVERAGE output filtered to the sample's own files (Node internals and node_modules dropped); otherwise as written"
  ],
