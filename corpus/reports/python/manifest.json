{
  "emitter": "python",
  "image": "python:3.14.10-slim",
  "tools": {
    "python": "Python 3.14.10",
    "coverage": "Coverage.py, version 7.17.0 with C extension"
  },
  "steps": [
    {
      "cwd": "/work/python",
      "command": "bash -c ../gen-big.sh py > src/sample/big.py"
    },
    {
      "cwd": "/work/python",
      "command": "coverage run test/run.py"
    },
    {
      "cwd": "/work/python",
      "command": "coverage json -o line.json"
    },
    {
      "cwd": "/work/python",
      "command": "coverage xml -o line.xml"
    },
    {
      "cwd": "/work/python",
      "command": "coverage lcov -o line.info"
    },
    {
      "cwd": "/work/python",
      "command": "coverage erase"
    },
    {
      "cwd": "/work/python",
      "command": "coverage run --branch test/run.py"
    },
    {
      "cwd": "/work/python",
      "command": "coverage json -o branch.json"
    },
    {
      "cwd": "/work/python",
      "command": "coverage xml -o branch.xml"
    },
    {
      "cwd": "/work/python",
      "command": "coverage lcov -o branch.info"
    },
    {
      "cwd": "/work/python",
      "command": "coverage erase"
    },
    {
      "cwd": "/work/python",
      "command": "coverage run --branch --parallel-mode --context=part-a test/run.py a"
    },
    {
      "cwd": "/work/python",
      "command": "coverage run --branch --parallel-mode --context=part-b test/run.py b"
    },
    {
      "cwd": "/work/python",
      "command": "coverage combine"
    },
    {
      "cwd": "/work/python",
      "command": "coverage json --show-contexts --include=src/sample/classify.py,lib/* -o contexts.json"
    }
  ],
  "notes": [
    "line-only/coverage.xml is Cobertura with branch-rate 0 and branches-valid 0 although branches were not measured",
    "contexts/coverage.json leaves out the generated big.py; with contexts shown, it alone made the report 60 MB"
  ],
