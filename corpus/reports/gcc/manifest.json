{
  "emitter": "gcc",
  "image": "gcc:15.3.0",
  "tools": {
    "gcc": "gcc (GCC) 15.3.0",
    "gcov": "gcov (GCC) 15.3.0",
    "lcov": "lcov: LCOV version 2.0-1",
    "lcov-package": "lcov 2.3.1-1",
    "gcovr": "gcovr 8.8"
  },
  "steps": [
    {
      "cwd": "/work/c",
      "command": "./build.sh gcc g++ -O0 --coverage -fcondition-coverage"
    },
    {
      "cwd": "/work/c",
      "command": "./build/test"
    },
    {
      "cwd": "/work/c/gcov-json",
      "command": "gcov --json-format --branch-probabilities --conditions --object-directory ../build ../build/big.gcda ../build/classify.gcda ../build/templates.gcda ../build/test_main.gcda ../build/util.gcda"
    },
    {
      "cwd": "/work/c",
      "command": "lcov --capture --directory build --base-directory . --output-file lcov-default.info"
    },
    {
      "cwd": "/work/c",
      "command": "lcov --capture --directory build --base-directory . --rc branch_coverage=1 --rc mcdc_coverage=1 --output-file lcov-branch-mcdc.info"
    },
    {
      "cwd": "/work/c",
      "command": "gcovr --root . --object-directory build --cobertura-pretty --cobertura gcovr-cobertura.xml --lcov gcovr.info --json-pretty --json gcovr.json"
    }
  ],
  "notes": [
    "gcov JSON writes one .gcov.json.gz per translation unit; static inline add() from lib/util.h appears in several of them"
  ],
  "reports": [
    {
