{
  "emitter": "llvm",
  "image": "debian:trixie-20261027",
  "tools": {
    "clang": "Debian clang version 19.1.7 (3+b1)",
    "llvm-cov": "Debian LLVM version 19.1.7"
  },
  "steps": [
    {
      "cwd": "/work/c",
      "command": "./build.sh clang clang++ -O0 -fprofile-instr-generate -fcoverage-mapping -fcoverage-mcdc"
    },
    {
      "cwd": "/work/c",
      "command": "env LLVM_PROFILE_FILE=build/test.profraw ./build/test"
    },
    {
      "cwd": "/work/c",
      "command": "llvm-profdata merge -sparse build/test.profraw -o build/test.profdata"
    },
    {
      "cwd": "/work/c",
      "command": "llvm-cov export ./build/test -instr-profile=build/test.profdata -format=text"
    },
    {
      "cwd": "/work/c",
      "command": "llvm-cov export ./build/test -instr-profile=build/test.profdata -format=text -summary-only"
    },
    {
      "cwd": "/work/c",
      "command": "llvm-cov export ./build/test -instr-profile=build/test.profdata -format=lcov"
    },
    {
      "cwd": "/work/c",
      "command": "llvm-cov export ./build/test -instr-profile=build/test.profdata -format=text -skip-expansions -skip-functions"
    }
  ],
  "notes": [
    "summary-only.json has totals per file and no per-line or per-region data"
  ],
