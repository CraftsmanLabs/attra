{
  "emitter": "dotnet",
  "image": "mcr.microsoft.com/dotnet/sdk:10.0.403",
  "tools": {
    "dotnet": "10.0.403",
    "coverlet": "coverlet.msbuild and coverlet.collector 10.1.0 (pinned in tests/Sample.Tests.csproj)",
    "dotnet-coverage": "18.12.0+e67518936dc54d459b37375c5eef5dc89f05d535"
  },
  "steps": [
    {
      "cwd": "/work/dotnet",
      "command": "bash -c ../gen-big.sh cs > src/Sample/Big.cs"
    },
    {
      "cwd": "/work/dotnet",
      "command": "dotnet build -v q tests/Sample.Tests"
    },
    {
      "cwd": "/work/dotnet",
      "command": "dotnet test --no-build -v q tests/Sample.Tests /p:CollectCoverage=true /p:CoverletOutputFormat=\"cobertura,opencover,lcov,json\" /p:CoverletOutput=/work/dotnet/coverlet/"
    },
    {
      "cwd": "/work/dotnet",
      "command": "dotnet test --no-build -v q tests/Sample.Tests --collect Code Coverage;Format=cobertura --results-directory ms-cobertura"
    },
    {
      "cwd": "/work/dotnet",
      "command": "bash -c cp ms-cobertura/*/*.cobertura.xml ms.cobertura.xml"
    },
    {
      "cwd": "/work/dotnet",
      "command": "dotnet test --no-build -v q tests/Sample.Tests --collect Code Coverage;Format=xml --results-directory ms-xml"
    },
    {
      "cwd": "/work/dotnet",
      "command": "bash -c cp ms-xml/*/*.xml ms.xml"
    },
    {
      "cwd": "/work/dotnet",
      "command": "dotnet-coverage collect -f cobertura -o empty.cobertura.xml dotnet test --no-build -v q tests/Sample.Tests"
    }
  ],
  "notes": [
    "dotnet-coverage/empty-run.cobertura.xml has no packages but line-rate=1 and branch-rate=1"
